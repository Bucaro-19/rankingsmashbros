DirectoryIndex index.html
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <Files "public.json">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>

# Included by PHP only; never served as a standalone endpoint.
<Files "database.php">
  Require all denied
</Files>
<Files "survey.php">
  Require all denied
</Files>
<Files "accounts.php">
  Require all denied
</Files>
# PHP may write its log beside the scripts; it must never be downloadable.
<Files "error_log">
  Require all denied
</Files>
