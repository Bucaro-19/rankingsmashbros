DirectoryIndex index.html
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Always revalidated, never served stale: an unchanged cut answers 304 instead of the whole file.
  <Files "public.json">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Stable public address of an organizer's top: /top/{slug}.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^top/([a-z0-9-]{1,60})/?$ top.php?o=$1 [L]
</IfModule>

# Included by PHP only; never served as a standalone endpoint.
<Files "database.php">
  Require all denied
</Files>
<Files "survey.php">
  Require all denied
</Files>
<Files "accounts.php">
  Require all denied
</Files>
<Files "visits.php">
  Require all denied
</Files>
<Files "stats.php">
  Require all denied
</Files>
<Files "analisis.php">
  Require all denied
</Files>
<Files "organizador.php">
  Require all denied
</Files>
<Files "premium.php">
  Require all denied
</Files>
<Files "ranking-import.php">
  Require all denied
</Files>
<Files "ranking-sync-lib.php">
  Require all denied
</Files>
<Files "ranking-worker.php">
  Require all denied
</Files>
# PHP may write its log beside the scripts; it must never be downloadable.
<Files "error_log">
  Require all denied
</Files>
